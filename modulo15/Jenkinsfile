pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalar dependências') {
            steps {
                dir('modulo15') {
                    bat 'npm install'
                }
            }
        }

        stage('Testes') {
            steps {
                dir('modulo15') {
                    bat '''
set NO_COLOR=1
npm run cy:run
'''
                }
            }
        }
    }
}
